{
  "name": "sjtu-login-addon",
  "version": "0.4.3",
  "private": true,
  "type": "module",
  "description": "Self-contained Chromium and Firefox extension for filling SJTU jAccount captchas.",
  "license": "MIT",
  "scripts": {
    "build": "node build.mjs",
    "build:chromium": "node build.mjs --target=chromium",
    "build:firefox": "node build.mjs --target=firefox",
    "check": "node --test tests/*.test.mjs",
    "lint:firefox": "web-ext lint --source-dir dist/firefox",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "onnxruntime-web": "1.27.0"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "web-ext": "10.6.0",
    "wrangler": "^4.112.0"
  }
}
